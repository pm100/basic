170 REM Test even/odd
180 PRINT "Check if numbers are even or odd:"
190 FOR I = 1 TO 10
200 IF I MOD 2 = 0 THEN 230
210 PRINT I; " is odd"
220 GOTO 240
230 PRINT I; " is even"
240 NEXT I
250 END
