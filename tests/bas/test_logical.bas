10 REM Test AND, OR, NOT operators
20 PRINT "Testing Logical Operators"
30 PRINT "========================="
40 PRINT ""
50 REM Test AND
60 PRINT "Test AND:"
70 IF 5 > 3 AND 10 < 20 THEN 100
80 PRINT "FAIL: 5>3 AND 10<20"
90 GOTO 110
100 PRINT "PASS: 5>3 AND 10<20"
110 IF 5 > 3 AND 10 > 20 THEN 140
120 PRINT "PASS: NOT (5>3 AND 10>20)"
130 GOTO 150
140 PRINT "FAIL: 5>3 AND 10>20 is true"
150 PRINT ""
160 REM Test OR
170 PRINT "Test OR:"
180 IF 5 > 3 OR 10 > 20 THEN 210
190 PRINT "FAIL: 5>3 OR 10>20"
200 GOTO 220
210 PRINT "PASS: 5>3 OR 10>20"
220 IF 5 < 3 OR 10 > 20 THEN 250
230 PRINT "PASS: NOT (5<3 OR 10>20)"
240 GOTO 260
250 PRINT "FAIL: 5<3 OR 10>20 is true"
260 PRINT ""
270 REM Test NOT
280 PRINT "Test NOT:"
290 IF NOT 5 > 10 THEN 320
300 PRINT "FAIL: NOT 5>10"
310 GOTO 330
320 PRINT "PASS: NOT 5>10"
330 IF NOT 5 < 10 THEN 360
340 PRINT "PASS: NOT (NOT 5<10)"
350 GOTO 370
360 PRINT "FAIL: NOT 5<10 is true"
370 PRINT ""
380 REM Test complex combinations
390 PRINT "Test Complex:"
400 IF (5 > 3 AND 10 < 20) OR 1 > 100 THEN 430
410 PRINT "FAIL: Complex expression"
420 GOTO 440
430 PRINT "PASS: (5>3 AND 10<20) OR 1>100"
440 PRINT ""
450 PRINT "All logical operator tests complete!"
460 END
