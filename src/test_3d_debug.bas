10 DIM CUBE(2,2,2)
20 LET N = 1
30 FOR I = 0 TO 2
40 FOR J = 0 TO 2
50 FOR K = 0 TO 2
60 LET CUBE(I,J,K) = N
70 LET N = N + 1
80 NEXT K
90 NEXT J
100 NEXT I
110 PRINT "Reading CUBE(0,0,0):"
120 PRINT CUBE(0,0,0)
130 PRINT "Reading CUBE(1,1,1):"
140 PRINT CUBE(1,1,1)
150 PRINT "Reading CUBE(2,2,2):"
160 PRINT CUBE(2,2,2)
170 END
