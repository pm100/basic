10 PRINT "Testing All Comparison Operators"
20 PRINT "================================="
30 PRINT ""
40 REM Test < (less than)
50 PRINT "Test <"
60 IF 5 < 10 THEN 90
70 PRINT "FAIL: 5 < 10"
80 GOTO 100
90 PRINT "PASS: 5 < 10"
100 IF 10 < 5 THEN 130
110 PRINT "PASS: NOT (10 < 5)"
120 GOTO 140
130 PRINT "FAIL: 10 < 5 is true"
140 PRINT ""
150 REM Test > (greater than)
160 PRINT "Test >"
170 IF 10 > 5 THEN 200
180 PRINT "FAIL: 10 > 5"
190 GOTO 210
200 PRINT "PASS: 10 > 5"
210 IF 5 > 10 THEN 240
220 PRINT "PASS: NOT (5 > 10)"
230 GOTO 250
240 PRINT "FAIL: 5 > 10 is true"
250 PRINT ""
260 REM Test <= (less than or equal)
270 PRINT "Test <="
280 IF 5 <= 10 THEN 310
290 PRINT "FAIL: 5 <= 10"
300 GOTO 320
310 PRINT "PASS: 5 <= 10"
320 IF 10 <= 10 THEN 350
330 PRINT "FAIL: 10 <= 10"
340 GOTO 360
350 PRINT "PASS: 10 <= 10"
360 IF 10 <= 5 THEN 390
370 PRINT "PASS: NOT (10 <= 5)"
380 GOTO 400
390 PRINT "FAIL: 10 <= 5 is true"
400 PRINT ""
410 REM Test >= (greater than or equal)
420 PRINT "Test >="
430 IF 10 >= 5 THEN 460
440 PRINT "FAIL: 10 >= 5"
450 GOTO 470
460 PRINT "PASS: 10 >= 5"
470 IF 10 >= 10 THEN 500
480 PRINT "FAIL: 10 >= 10"
490 GOTO 510
500 PRINT "PASS: 10 >= 10"
510 IF 5 >= 10 THEN 540
520 PRINT "PASS: NOT (5 >= 10)"
530 GOTO 550
540 PRINT "FAIL: 5 >= 10 is true"
550 PRINT ""
560 REM Test = (equal)
570 PRINT "Test ="
580 IF 10 = 10 THEN 610
590 PRINT "FAIL: 10 = 10"
600 GOTO 620
610 PRINT "PASS: 10 = 10"
620 IF 10 = 5 THEN 650
630 PRINT "PASS: NOT (10 = 5)"
640 GOTO 660
650 PRINT "FAIL: 10 = 5 is true"
660 PRINT ""
670 REM Test <> (not equal)
680 PRINT "Test <>"
690 IF 10 <> 5 THEN 720
700 PRINT "FAIL: 10 <> 5"
710 GOTO 730
720 PRINT "PASS: 10 <> 5"
730 IF 10 <> 10 THEN 760
740 PRINT "PASS: NOT (10 <> 10)"
750 GOTO 770
760 PRINT "FAIL: 10 <> 10 is true"
770 PRINT ""
780 REM Test with variables
790 PRINT "Test with variables"
800 LET A = 5
810 LET B = 10
820 IF A < B THEN 850
830 PRINT "FAIL: A < B"
840 GOTO 860
850 PRINT "PASS: A < B (5 < 10)"
860 IF B > A THEN 890
870 PRINT "FAIL: B > A"
880 GOTO 900
890 PRINT "PASS: B > A (10 > 5)"
900 LET C = 5
910 IF A = C THEN 940
920 PRINT "FAIL: A = C"
930 GOTO 950
940 PRINT "PASS: A = C (5 = 5)"
950 IF A <> B THEN 980
960 PRINT "FAIL: A <> B"
970 GOTO 990
980 PRINT "PASS: A <> B (5 <> 10)"
990 PRINT ""
1000 PRINT "All comparison tests complete!"
1010 END
