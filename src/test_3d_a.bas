10 DIM A(2,2,2)
20 LET N = 1
30 FOR I = 0 TO 2
40 FOR J = 0 TO 2
50 FOR K = 0 TO 2
60 LET A(I,J,K) = N
70 LET N = N + 1
80 NEXT K
90 NEXT J
100 NEXT I
110 PRINT "Reading A(0,0,0):"
120 PRINT A(0,0,0)
130 PRINT "Reading A(1,1,1):"
140 PRINT A(1,1,1)
150 PRINT "Reading A(2,2,2):"
160 PRINT A(2,2,2)
170 END
