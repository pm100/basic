10 PRINT "Matrix Multiplication Example"
20 PRINT "=============================="
30 PRINT ""
40 DATA 1, 2, 3
50 DATA 4, 5, 6
60 PRINT "Original matrix (2x3):"
70 FOR ROW = 1 TO 2
80 RESTORE
90 FOR SKIP = 1 TO ROW - 1
100 READ DUMMY, DUMMY, DUMMY
110 NEXT SKIP
120 READ A, B, C
130 PRINT A
140 PRINT B
150 PRINT C
160 NEXT ROW
170 PRINT ""
180 PRINT "Multiplying by 10:"
190 FOR ROW = 1 TO 2
200 RESTORE
210 FOR SKIP = 1 TO ROW - 1
220 READ DUMMY, DUMMY, DUMMY
230 NEXT SKIP
240 READ A, B, C
250 PRINT A * 10
260 PRINT B * 10
270 PRINT C * 10
280 NEXT ROW
290 END
