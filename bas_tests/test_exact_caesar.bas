10 LET MESSAGE = "ABC"
20 LET C1 = ASC(LEFT$(MESSAGE, 1)) + 3
30 LET C2 = ASC(MID$(MESSAGE, 2, 1)) + 3
40 LET C3 = ASC(MID$(MESSAGE, 3, 1)) + 3
50 PRINT "C1 C2 C3:"
60 PRINT C1
70 PRINT C2
80 PRINT C3
90 LET ENCRYPTED = CHR$(C1) + CHR$(C2) + CHR$(C3)
100 PRINT "Encrypted:"
110 PRINT ENCRYPTED
120 END
