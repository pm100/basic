10 DIM A(1,1,1)
20 PRINT "Filling 2x2x2 array"
30 LET N = 0
40 FOR I = 0 TO 1
50 FOR J = 0 TO 1
60 FOR K = 0 TO 1
70 LET A(I,J,K) = N
80 LET N = N + 1
90 NEXT K
100 NEXT J
110 NEXT I
120 PRINT "Reading all values:"
130 FOR I = 0 TO 1
140 FOR J = 0 TO 1
150 FOR K = 0 TO 1
160 PRINT A(I,J,K)
170 NEXT K
180 NEXT J
190 NEXT I
200 END
